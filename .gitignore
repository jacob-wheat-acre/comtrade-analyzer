__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.env
.venv
venv/

# Runtime output — generated by the tool, not source
ct_output/
wso_output/

# Generated outputs that may land next to test event files
*_waveform.png
*_rms.png
*_sequence.png
*_phasors.png
*_output.csv
*_summary.json
*_report.docx

# Scratch output from comtrade-demo-fleet. The tracked demo set lives in
# demo/ and IS committed on purpose — it is the only way to show the tool
# before real COMTRADE files are flowing.
fleet/

# Batch output. comtrade-batch writes <folder>/analysis, and the folder it is
# pointed at is often a tracked one — this swept 5 MB of generated dashboards
# into a commit once. Bare on purpose, like devices.csv below, so it catches
# the directory wherever a run drops it.
analysis/

# Device registry — contains operational/customer data, do not commit
# Copy devices_template.csv to devices.csv and populate it locally.
# The pattern is deliberately bare so it catches a registry dropped anywhere
# in the tree; the demo set's invented registry is the one exception.
devices.csv
!demo/devices.csv

# Feeder connectivity — real mainline topology is operational data too.
# Copy comtrade_analyzer/topology_template.csv to topology.csv and fill it in.
topology.csv
!demo/topology.csv

# macOS
.DS_Store
